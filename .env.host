APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:your_app_key_here
APP_DEBUG=false
APP_URL=https://peda.agu.edu.vn

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cấu hình Cache & Session lưu dạng file để không phụ thuộc MongoDB khi clear cache
CACHE_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Cấu hình MongoDB
DB_CONNECTION=mongodb
DB_HOST=172.16.0.12
DB_PORT=27017
DB_DATABASE=pedadb
DB_USERNAME=peda_user
DB_PASSWORD=your_password_here
DB_AUTHENTICATION_DATABASE=pedadb
